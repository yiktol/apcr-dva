{
  "family": "coffee-shop-prod",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "<EXECUTION_ROLE_ARN>",
  "taskRoleArn": "<TASK_ROLE_ARN>",
  "containerDefinitions": [
    {
      "name": "web",
      "image": "<IMAGE1_NAME>",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "ORDERS_QUEUE_URL",
          "value": "<ORDERS_QUEUE_URL>"
        },
        {
          "name": "ORDERS_TABLE_NAME",
          "value": "coffee-shop-orders"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/coffee-shop-prod",
          "awslogs-region": "ap-southeast-1",
          "awslogs-stream-prefix": "coffee-shop-prod"
        }
      }
    }
  ]
}
